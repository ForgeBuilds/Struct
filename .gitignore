.uic/
/build*/
/.qtcreator/
# (merge-conflict markers removed — both rule sets above are active)
*.keystore
*.jks
# Tauri updater signing keys — the private key must never be committed.
# `tauri signer generate -w <path>` writes `<name>.key` alongside `<name>.key.pub`.
*.key
# Environment variables — never commit real Supabase credentials.
# `.env.example` is the template and stays tracked.
.env
.env.*
!.env.example

# Supabase CLI scratch files — regenerated locally by `supabase link`.
supabase/.temp/ 
# LSP verification harness scratch dir 
scripts/.lsp-tmp
scripts/.history-tmp
# ── scratch / generated debris ──────────────────────────────────────────────
# One-off tool output that used to be committed at the repo root. Regenerate
# by re-running the matching tool; never worth versioning.
tsc*.txt
cs-out.txt
b2.txt
t_oauth.txt
eslint.json
audit-all.txt
# scratch scripts (the `_`-prefixed helpers under scripts/ follow the same idea)
hl-tmp.mjs
scratch-*.tsx
# accidental shell-redirect debris, e.g. `git log > 0` or `cargo check 2`
/0
/1
/c
/{
src-tauri/cargo*.txt
src-tauri/chk.txt
# Browser "Save Page As" dumps accidentally saved into the asset tree.
src/assets/images/*_files/

# Bundled Struct code-oss workbench (regenerate via Vector build; do not commit)
src-tauri/resources/
