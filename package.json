{
  "name": "struct",
  "private": true,
  "version": "1.16.0",
  "desktopName": "com.lumorixstudios.agenticcoder",
  "description": "Struct - a fast, local-first AI coding agent in a single native window",
  "author": "Lumorix Studios <contact@lumorixstudios.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/electron-dev.mjs",
    "check:supabase-env": "node scripts/check-supabase-env.mjs",
    "build": "npm run build:freellmapi && tsc -b && vite build",
    "build:freellmapi": "node scripts/build-freellmapi.mjs",
    "build:electron:renderer": "npm run build",
    "build:desktop": "node scripts/desktop-build.mjs",
    "build:desktop:bundle": "node scripts/desktop-build.mjs --bundle-only",
    "build:desktop:unsigned": "node scripts/desktop-build.mjs",
    "build:linux": "node scripts/desktop-build.mjs -- --linux AppImage deb rpm",
    "build:mac": "node scripts/desktop-build.mjs -- --mac dmg",
    "build:win": "node scripts/desktop-build.mjs -- --win nsis",
    "icons": "node scripts/generate-icons.mjs",
    "electron": "electron .",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "translations:generate": "node scripts/generate-translations.mjs",
    "version": "node scripts/generate-release-notes.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@shikijs/transformers": "^4.5.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "^8.20.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.0.0",
    "undici": "^6.21.0",
    "zod": "^4.6.7",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@babel/core": "^7.29.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-query": "^5.97.0",
    "@types/babel__core": "^7.20.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "highlight.js": "^11.12.0",
    "liquid-gooey": "^0.2.1",
    "lucide-react": "^1.8.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "simple-icons": "^16.31.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "tar": "^7.4.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.lumorixstudios.agenticcoder",
    "productName": "Struct",
    "protocols": [
      {
        "name": "Struct",
        "schemes": [
          "agenticcoder"
        ]
      }
    ],
    "files": [
      "electron/*.cjs",
      "electron/freellmapi-runtime/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "licenses/freellmapi-MIT.txt",
        "to": "licenses/freellmapi-MIT.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Lumorix Studios <contact@lumorixstudios.com>"
    },
    "publish": null
  }
}
