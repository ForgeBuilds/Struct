{
  "name": "neo",
  "private": true,
  "version": "1.12.0",
  "desktopName": "com.lumorixstudios.agenticcoder",
  "description": "Struct - a fast, local-first AI coding agent in a single native window",
  "author": "Lumorix Studios <contact@lumorixstudios.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/electron-dev.mjs",
    "build": "tsc -b && vite build",
    "build:electron:renderer": "npm run build",
    "build:desktop": "node scripts/desktop-build.mjs",
    "build:desktop:bundle": "node scripts/desktop-build.mjs --bundle-only",
    "build:desktop:unsigned": "node scripts/desktop-build.mjs",
    "build:linux": "node scripts/desktop-build.mjs -- --linux AppImage deb",
    "build:mac": "node scripts/desktop-build.mjs -- --mac dmg",
    "build:win": "node scripts/desktop-build.mjs -- --win nsis",
    "icons": "node scripts/generate-icons.mjs",
    "electron": "electron .",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "version": "node scripts/generate-release-notes.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.lumorixstudios.agenticcoder",
    "productName": "Struct",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Lumorix Studios <contact@lumorixstudios.com>"
    },
    "publish": null
  }
}
